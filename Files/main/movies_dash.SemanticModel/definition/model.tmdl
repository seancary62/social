model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["actors","directors","genres","media_all","studios"]

annotation PBI_ProTooling = ["DevMode"]

ref table actors
ref table directors
ref table genres
ref table media_all
ref table studios

ref cultureInfo en-US

